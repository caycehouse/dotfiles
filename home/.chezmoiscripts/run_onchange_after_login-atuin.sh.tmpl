{{- if (not .isWorkComputer) -}}
#!/usr/bin/env bash

set -eufo pipefail

command -v atuin >/dev/null 2>&1 || exit 0
command -v op >/dev/null 2>&1 || exit 0

# atuin status exits non-zero when there is no sync session.
if atuin status >/dev/null 2>&1; then
  echo "Already logged in to atuin."
  exit 0
fi

echo "Logging in to atuin..."
atuin_username="$(op read 'op://dotfiles/atuin/username')"
atuin_password="$(op read 'op://dotfiles/atuin/password')"
atuin_key="$(op read 'op://dotfiles/atuin/key')"

# atuin reads the key from stdin when --key is omitted, keeping it out of the process list.
atuin login -u "$atuin_username" -p "$atuin_password" <<<"$atuin_key"

{{ end -}}
