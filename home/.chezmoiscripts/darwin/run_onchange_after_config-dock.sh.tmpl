#!/usr/bin/env bash

set -eufo pipefail

trap 'killall Dock' EXIT

declare -a remove_labels=(
  Books
  Calendar
  Contacts
  FaceTime
  Freeform
  Games
  Keynote
  Maps
  News
  Notes
  Numbers
  Pages
  Photos
  Reminders
  TV
)

for label in "${remove_labels[@]}"; do
  if dockutil --find "${label}" >/dev/null 2>&1; then
    dockutil --no-restart --remove "${label}"
  fi
done

add_app() {
  local path=$1
  local label=$2

  # Skip apps whose install failed rather than aborting the rest of the Dock setup.
  [[ -d "${path}" ]] || return 0
  dockutil --add "${path}" --label "${label}" --replacing "${label}" --no-restart "${@:3}"
}

add_app '/Applications/Google Chrome.app' 'Google Chrome' --position 2
add_app '/Applications/Ghostty.app' 'Ghostty'
add_app '/Applications/Visual Studio Code.app' 'Visual Studio Code'
add_app '/Applications/Keka.app' 'Keka'

{{- if (not .isWorkComputer) }}
add_app '/Applications/GeForceNOW.app' 'NVIDIA GeForce NOW'
{{- end }}
