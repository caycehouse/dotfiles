{
  "cleanupPeriodDays": 90,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "env": {
    "MEMINI_BASE_URL": "https://memini.housefam.casa",
    "MEMINI_HOME": "personal/cayce"
  },
  "skillOverrides": {
    "agents-sdk": "off",
    "cloudflare": "off",
    "cloudflare-email-service": "off",
    "durable-objects": "off",
    "sandbox-sdk": "off",
    "turnstile-spin": "off",
    "web-perf": "off",
    "workers-best-practices": "off",
    "wrangler": "off"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "spritecook@spritecook": true,
    "memini@memini": true
  },
  "extraKnownMarketplaces": {
    "spritecook": {
      "source": {
        "source": "git",
        "url": "https://github.com/SpriteCook/claude-plugin.git"
      }
    },
    "memini": {
      "source": {
        "source": "git",
        "url": "https://github.com/eleboucher/memini.git"
      }
    }
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": true
  },
  "syntaxHighlightingDisabled": false,
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
